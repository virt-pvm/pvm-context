# Trusted shell config outside the checkout; never publish the real file.
# Run on the validation host, or configure an SSH delegation below.
PVM_FACTORY_HOST=local
PVM_FACTORY_ROOT=/srv/pvm-factory
PVM_RUNTIME_BASE=/srv/pvm-assets/runtime-base.qcow2
PVM_RUNTIME_SHA256=replace_with_sha256_of_readonly_runtime_base
PVM_SOURCE_BUNDLES=/srv/pvm-assets/oot-source
# Optional local Git cache: automatically regenerate the pinned bundle.
# PVM_OOT_REPO=/srv/pvm-assets/oot-66-git-cache
PVM_QEMU_BIN=qemu-system-x86_64
PVM_VM_CPUS=8
PVM_VM_MEMORY=16G
PVM_JOBS=4

# Optional per-target image/repository/toolchain settings.
# PVM_IMAGE_FILE=/srv/pvm-assets/official-cloud-image.qcow2
# PVM_IMAGE_URL=https://official-vendor.example/image.qcow2
# PVM_IMAGE_SHA256=replace_with_vendor_verified_sha256
# PVM_IMAGE_CHECKSUMS_URL=https://official-vendor.example/SHA256SUMS
# PVM_APT_MIRROR=https://archive.ubuntu.com/ubuntu
# PVM_APT_SNAPSHOT=20261020T000000Z
# PVM_KERNEL_DEB_VERSION=6.8.0-139.139
# PVM_EXTRA_PACKAGES='gcc-13=13.3.0-6ubuntu2~24.04.1'
# PVM_CC=x86_64-linux-gnu-gcc-13
# PVM_DNS_SCRIPTS_DIR=/srv/pvm-private/cubesandbox-dns
# PVM_GUEST_PREPARE_HOOK=/srv/pvm-private/configure-package-repositories.sh
# PVM_KERNEL_RPM_CACHE_DIR=/srv/pvm-assets/native-kernel-rpms
# PVM_KEEP_DISKS=1

# Controller outside the validation host: use an SSH alias from ~/.ssh/config.
# PVM_FACTORY_HOST=validation-host
# PVM_FACTORY_CONTEXT=/srv/pvm-context
# PVM_FACTORY_ENV=/srv/pvm-private/ubuntu24.env
