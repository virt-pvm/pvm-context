#!/usr/bin/env bash

# Host-side paths. Keep machine-specific values in an untracked override file.
PVM_VALIDATION_HOST="${PVM_VALIDATION_HOST:-}"
PVM_REMOTE_ROOT="${PVM_REMOTE_ROOT:-}"
PVM_WORK_DIR="${PVM_WORK_DIR:-}"
PVM_66_BASE_SOURCE="${PVM_66_BASE_SOURCE:-}"
PVM_612_BASE_SOURCE="${PVM_612_BASE_SOURCE:-}"
PVM_66_SOURCE_WORKTREE="${PVM_66_SOURCE_WORKTREE:-}"
PVM_612_SOURCE_WORKTREE="${PVM_612_SOURCE_WORKTREE:-}"
PVM_GUEST_SOURCE_WORKTREE="${PVM_GUEST_SOURCE_WORKTREE:-}"
# Optional controller-side override. By default the workflow uses the newest
# Dragonball guest config shipped in the installed Kata archive.
PVM_GUEST_CONFIG="${PVM_GUEST_CONFIG:-}"

# Optional controller-side worktrees. The validation-host wrapper stages these
# before invoking the workflow remotely.
PVM_CONTROL_66_BASE_SOURCE="${PVM_CONTROL_66_BASE_SOURCE:-}"
PVM_CONTROL_612_BASE_SOURCE="${PVM_CONTROL_612_BASE_SOURCE:-}"
PVM_CONTROL_66_SOURCE_WORKTREE="${PVM_CONTROL_66_SOURCE_WORKTREE:-}"
PVM_CONTROL_612_SOURCE_WORKTREE="${PVM_CONTROL_612_SOURCE_WORKTREE:-}"
PVM_CONTROL_GUEST_SOURCE_WORKTREE="${PVM_CONTROL_GUEST_SOURCE_WORKTREE:-}"

# Official Ubuntu 24.04 LTS cloud image.
UBUNTU_IMAGE_BASE_URL="${UBUNTU_IMAGE_BASE_URL:-https://cloud-images.ubuntu.com/releases/24.04/release}"
UBUNTU_IMAGE_NAME="${UBUNTU_IMAGE_NAME:-ubuntu-24.04-server-cloudimg-amd64.img}"
ROOT_DISK_SIZE="${ROOT_DISK_SIZE:-48G}"
SHARED_DISK_SIZE="${SHARED_DISK_SIZE:-160G}"
# Optional immutable runtime base and per-VM writable overlay. When unset, the
# workflow creates a standalone shared disk for compatibility.
PVM_SHARED_BASE="${PVM_SHARED_BASE:-}"
PVM_SHARED_OVERLAY="${PVM_SHARED_OVERLAY:-}"

# Local QEMU VM.
QEMU_BIN="${QEMU_BIN:-qemu-system-x86_64}"
QEMU_IMG_BIN="${QEMU_IMG_BIN:-qemu-img}"
QEMU_DATA_DIR="${QEMU_DATA_DIR:-}"
QEMU_USE_SUDO="${QEMU_USE_SUDO:-0}"
QEMU_CGROUP_PROCS="${QEMU_CGROUP_PROCS:-}"
VM_MACHINE_TYPE="${VM_MACHINE_TYPE:-q35}"
VM_CPUS="${VM_CPUS:-16}"
VM_MEMORY="${VM_MEMORY:-16G}"
VM_SSH_PORT="${VM_SSH_PORT:-2224}"
VM_SSH_USER="${VM_SSH_USER:-pvm}"

# Kata QEMU/CLH assets can be downloaded from upstream or supplied locally.
KATA_VERSION="${KATA_VERSION:-4.2.0}"
KATA_ARCHIVE="${KATA_ARCHIVE:-}"
PVM_CONTROL_KATA_ARCHIVE="${PVM_CONTROL_KATA_ARCHIVE:-}"
KATA_ARCHIVE_URL="${KATA_ARCHIVE_URL:-https://github.com/kata-containers/kata-containers/releases/download/${KATA_VERSION}/kata-static-${KATA_VERSION}-amd64.tar.zst}"
KATA_ARCHIVE_SHA256="${KATA_ARCHIVE_SHA256:-b828904fa3f1e49ddd7dc799c72cb1503cd1e772d354c3987c8d4189b2a623a8}"

# Kata 4.2 does not bundle Firecracker. Pin and verify its official release.
FIRECRACKER_VERSION="${FIRECRACKER_VERSION:-1.17.0}"
FIRECRACKER_ARCHIVE="${FIRECRACKER_ARCHIVE:-}"
PVM_CONTROL_FIRECRACKER_ARCHIVE="${PVM_CONTROL_FIRECRACKER_ARCHIVE:-}"
FIRECRACKER_ARCHIVE_URL="${FIRECRACKER_ARCHIVE_URL:-https://github.com/firecracker-microvm/firecracker/releases/download/v${FIRECRACKER_VERSION}/firecracker-v${FIRECRACKER_VERSION}-x86_64.tgz}"
FIRECRACKER_ARCHIVE_SHA256="${FIRECRACKER_ARCHIVE_SHA256:-06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558}"

# OOT source provenance.
PVM_REPO_URL="${PVM_REPO_URL:-https://github.com/virt-pvm/linux.git}"
PVM_66_BRANCH="${PVM_66_BRANCH:-pvm-6.6-host-oot}"
PVM_612_BRANCH="${PVM_612_BRANCH:-pvm-6.12-host-oot}"
PVM_66_KERNEL_RELEASE="${PVM_66_KERNEL_RELEASE:-6.6.144}"
PVM_612_KERNEL_RELEASE="${PVM_612_KERNEL_RELEASE:-6.12.33}"
PVM_HOST_CMDLINE="${PVM_HOST_CMDLINE:-nokaslr}"
PVM_JOBS="${PVM_JOBS:-${VM_CPUS}}"
