# Copy to configs/targets.local.env, which is ignored by Git.
# These values bind a tracked target to a pre-existing VM.
# Optional guest-side runtime locations for the full Kata/CubeSandbox gate:
# PVM_KATA_CONFIG_DIR=/opt/kata/share/defaults/kata-containers/runtime-rs-4.2.0
# PVM_CUBE_ENV_FILE=/usr/local/services/cubetoolbox/.one-click.env
# PVM_CUBE_ROOT=/build/pvm-shared
# PVM_KATA_SHIM_OVERRIDE=/path/in/guest/to/containerd-shim-kata-v2
# The shim override is bind-mounted only during the Kata test.
PVM_SSH_HOST=validation-host
PVM_QEMU_BIN=/path/on/validation-host/to/qemu-system-x86_64
PVM_QEMU_SHARE=/path/on/validation-host/to/qemu/share
# Set to 1 only when the validation host grants noninteractive QEMU startup.
PVM_VM_USE_SUDO=1

case "$PVM_TARGET_NAME" in
  ubuntu-24.04-6.8.0-139)
    PVM_VM_PORT=3301
    PVM_VM_USER=pvm
    PVM_VM_KEY=/path/on/validation-host/to/id_ed25519
    PVM_VM_NAME=pvm-u2404
    PVM_VM_ROOT_DISK=/path/on/validation-host/to/ubuntu-24.04-root.qcow2
    PVM_VM_SHARED_DISK=/path/on/validation-host/to/ubuntu-24.04-shared-overlay.qcow2
    PVM_VM_SEED_ISO=/path/on/validation-host/to/ubuntu-24.04-seed.iso
    PVM_VM_CPUS=8
    PVM_VM_MEMORY=8G
    ;;
  centos-stream-10-6.12.0-267)
    PVM_VM_PORT=3302
    PVM_VM_USER=root
    PVM_VM_KEY=/path/on/validation-host/to/id_ed25519
    PVM_VM_NAME=pvm-centos-stream-10
    PVM_VM_ROOT_DISK=/path/on/validation-host/to/centos-root.qcow2
    PVM_VM_SHARED_DISK=/path/on/validation-host/to/centos-shared-overlay.qcow2
    PVM_VM_CPUS=4
    PVM_VM_MEMORY=8G
    ;;
  *)
    echo "no local VM mapping for $PVM_TARGET_NAME" >&2
    return 2
    ;;
esac
