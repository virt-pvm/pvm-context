[Unit]
Description=Docker from the PVM shared runtime disk
Requires=containerd.service
RequiresMountsFor=/build
After=containerd.service network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/dockerd --host=unix:///run/docker.sock --containerd=/run/containerd/containerd.sock --data-root=/build/pvm-shared/state/docker --userland-proxy=false
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
