{
  "boot-source": {
    "kernel_image_path": "/opt/kata/share/kata-containers/vmlinux.pvm",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda1 ro rootfstype=ext4 systemd.unit=kata-containers.target"
  },
  "drives": [
    {
      "drive_id": "rootfs",
    "path_on_host": "/opt/kata/share/kata-containers/kata-ubuntu-resolute.image",
      "is_root_device": false,
      "is_read_only": true
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 512,
    "smt": false,
    "track_dirty_pages": false
  }
}
